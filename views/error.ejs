<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="alert alert-danger col-6 offset-3" role="alert">
    <p class="alert-heading"><%= (typeof message !== "undefined" && message) ? message : ((typeof err !== "undefined" && err.message) ? err.message : "Something went wrong!") %></p>
  </div>
</div>