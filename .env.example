# MongoDB Atlas Connection URL (Standard / Legacy Non-SRV format or SRV format)
ATLASDB_URL=mongodb://<username>:<password>@ac-sb4ypud-shard-00-00.cpjjvil.mongodb.net:27017,ac-sb4ypud-shard-00-01.cpjjvil.mongodb.net:27017,ac-sb4ypud-shard-00-02.cpjjvil.mongodb.net:27017/wanderlust?ssl=true&replicaSet=atlas-tmo3e3-shard-0&authSource=admin&retryWrites=true&w=majority

# Session Encryption Secret
SECRET=your_secret_key_here

# Cloudinary Credentials (for photo uploads)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret

# Mapbox Token (Optional: if omitted, app automatically uses free OpenStreetMap / Leaflet)
MAP_TOKEN=pk.your_mapbox_token_here

# Server Port
PORT=8080
